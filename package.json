{
  "name": "vgc-dex",
  "private": true,
  "version": "0.1.25",
  "type": "module",
  "description": "Mobile-first Pokédex for Pokémon Champions VGC Doubles (Regulation M-C) with usage-rate and move-usage data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:data": "node scripts/build-data.mjs",
    "build:movedex": "node scripts/build-movedex.mjs",
    "build:itemdex": "node scripts/build-itemdex.mjs",
    "build:megadex": "node scripts/build-megadex.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "ingest:usage": "node scripts/ingest-usage.mjs",
    "version:bump": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
